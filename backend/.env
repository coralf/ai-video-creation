ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_CHAT_MODEL=
ARK_CHAT_EXTRA_BODY={"temperature":0.7}

# 如果你的图片模型走 OpenAI 兼容接口，可以只填模型名。
VOLCENGINE_IMAGE_MODEL=

# 如果你的图片接口不是 /images/generations，可直接填完整地址覆盖默认值。
VOLCENGINE_IMAGE_ENDPOINT=

# 可选。用于补充火山引擎图片接口的额外参数。
VOLCENGINE_IMAGE_EXTRA_BODY={}
