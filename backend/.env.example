DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
QWEN_CHAT_MODEL=qwen3.5-plus
QWEN_CHAT_EXTRA_BODY={"temperature":0.7}

# 图片生成接口仍然预留给第三方服务。
VOLCENGINE_IMAGE_MODEL=
VOLCENGINE_IMAGE_ENDPOINT=
VOLCENGINE_IMAGE_API_KEY=
VOLCENGINE_VIDEO_MODEL=
VOLCENGINE_VIDEO_ENDPOINT=
VOLCENGINE_VIDEO_API_KEY=

# 可选。用于补充图片接口的额外参数。
VOLCENGINE_IMAGE_EXTRA_BODY={}
VOLCENGINE_VIDEO_EXTRA_BODY={}
